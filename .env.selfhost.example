# Copy this file to .env on the static-IP machine.
# Never commit .env or put real passwords in this file in GitHub.

# Public DNS name pointing to this machine's static IP.
HUB_DOMAIN=hub.example.com

HOST=0.0.0.0
PORT=3000
NODE_ENV=production
XEOMA_DEMO_MODE=true

# After validating the demo, set XEOMA_DEMO_MODE=false and replace this with
# your four site records. Keep it on the machine only or load it from a secret manager.
XEOMA_SERVERS_JSON=[]
