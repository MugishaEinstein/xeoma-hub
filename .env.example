# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Keep demo mode enabled until real Xeoma servers are configured.
XEOMA_DEMO_MODE=true

# Optional JSON array. Never commit real credentials.
# Example: [{"id":"site-4","name":"Site 4","network":"dynamic","host":"https://xeoma-site-4.example.com","username":"viewer","password":"change-me","webViewUrl":"https://xeoma-site-4.example.com/view/...","location":"Dynamic IP site"}]
# network is "static" or "dynamic". A raw IP with network "dynamic" is rejected; use a tunnel or DDNS hostname.
XEOMA_SERVERS_JSON=[]
